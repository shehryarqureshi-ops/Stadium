# Consent + tracking — see app/lib/tracking/config.ts
#
# NEXT_PUBLIC_APP_ENV decides what runs:
#   development  (default / unset)  local dev: no tags, no events, Marker.io widget ON
#   staging                         pre-production: Osano + analytics ON but only against
#                                   STAGING ids/hosts you set below; Marker.io OFF;
#                                   Book-a-call form -> STAGING backend
#   production                      the live site: production GTM/Clarity/HubSpot/Zendesk,
#                                   Marker.io OFF, Book-a-call form -> PRODUCTION backend
# On Vercel: Production env -> production, Preview env -> staging. (Do NOT rely on
# VERCEL_ENV: a staging site can be a Vercel "production" deployment.)
# See .env.staging.example for the exact variable set of a staging deployment.
NEXT_PUBLIC_APP_ENV=development

# Second guard: analytics only run when the page is served from one of these
# hostnames, so a mis-set APP_ENV can never send staging traffic to live data
# (or live traffic to staging). Defaults to the live domains in production;
# staging has NO default — set it to the staging domain.
# (NEXT_PUBLIC_PRODUCTION_HOSTS is still read as a fallback.)
NEXT_PUBLIC_ANALYTICS_HOSTS=www.bystadium.com,bystadium.com

# Local testing of the consent banner ("Cookie Preferences") and the Zendesk
# widget ("Need Help?") ONLY. Loads Osano + Zendesk in dev; GTM, Clarity,
# HubSpot and all events stay off in dev. Leave false/unset normally.
NEXT_PUBLIC_WIDGETS_PREVIEW=false

# Console logging of every event. When analytics are inactive this is a dry run
# (nothing is sent), handy while developing.
NEXT_PUBLIC_TRACKING_DEBUG=false

# Marker.io feedback widget: on in development only. Force on with true.
# NEXT_PUBLIC_MARKER_ENABLED=false

# Optional overrides. In PRODUCTION these default to the IDs already used on
# bystadium.com; on STAGING they have no default (the tool stays off until set).
# NEXT_PUBLIC_OSANO_SRC=
# NEXT_PUBLIC_GTM_ID=GTM-KWGXDZ6
# NEXT_PUBLIC_CLARITY_ID=g5rwwcq46l
# NEXT_PUBLIC_HUBSPOT_PORTAL_ID=8084862
# NEXT_PUBLIC_ZENDESK_KEY=
# NEXT_PUBLIC_HELP_CENTER_URL=https://help.bystadium.com

# Book-a-call form backend: follows NEXT_PUBLIC_APP_ENV (production -> production
# profile, everything else -> staging profile). A staging deployment can never use
# the production profile. Optional overrides (see BookACallForm.tsx):
# NEXT_PUBLIC_APP_MODE=mock            # offline: simulate every network call
# NEXT_PUBLIC_SM_API_HOST=
# NEXT_PUBLIC_HUBSPOT_BOOK_A_CALL_FORM_GUID=
# NEXT_PUBLIC_HUBSPOT_BOOK_A_CALL_PARTIAL_FORM_GUID=
# NEXT_PUBLIC_GOOGLE_RECAPTCHA_SITEKEY=
# NEXT_PUBLIC_THANK_YOU_PAGE_URL=/thank-you
