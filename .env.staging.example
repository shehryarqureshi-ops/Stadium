# Environment variables for the STAGING deployment (copy into the host's env settings;
# do not commit real values). Everything marked REQUIRED must be set or that piece
# stays off by design — staging never falls back to production ids.

NEXT_PUBLIC_APP_ENV=staging                      # REQUIRED — enables Osano + analytics, disables Marker.io, staging form backend

# REQUIRED: the staging domain(s), comma separated, no protocol. Analytics only run on these hosts.
NEXT_PUBLIC_ANALYTICS_HOSTS=staging.example.com

# REQUIRED for analytics: the STAGING GTM container (GA4 etc. live inside it).
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Share previews (Facebook / X / LinkedIn / WhatsApp): og:url, og:image and twitter:image resolve against the
# staging host, so crawlers can fetch the image from the page that was shared. By default this is the FIRST host
# in NEXT_PUBLIC_ANALYTICS_HOSTS above (https://<host>). Set this only to override it. Canonicals stay on production.
# NEXT_PUBLIC_SHARE_ORIGIN=https://staging.example.com

# Osano: uses the production consent config unless you point at a staging one.
# The staging domain must be added to that Osano configuration or the banner won't show.
# NEXT_PUBLIC_OSANO_SRC=https://cmp.osano.com/<account>/<staging-config>/osano.js

# Optional — leave unset to keep these OFF on staging (no data into the live projects)
# NEXT_PUBLIC_CLARITY_ID=
# NEXT_PUBLIC_HUBSPOT_PORTAL_ID=

# Book-a-call form: nothing to set. APP_ENV=staging selects the staging profile
# (test-api.snackmagic.com, staging HubSpot form GUIDs, test-inbound-router).
# Do NOT set NEXT_PUBLIC_APP_MODE=production here (it is ignored on staging anyway).

# Marker.io is OFF on staging. Do not set NEXT_PUBLIC_MARKER_ENABLED.
